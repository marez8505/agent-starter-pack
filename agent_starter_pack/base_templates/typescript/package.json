{
  "name": "{{cookiecutter.project_name}}",
  "version": "1.0.0",
  "description": "AI Agent built with Google ADK (TypeScript)",
  "type": "module",
  "main": "{{cookiecutter.agent_directory}}/agent.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && npx @google/adk-devtools web -h localhost dist/agent.js",
    "run": "tsc && npx @google/adk-devtools run dist/agent.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@google/adk": "^1.3.0",
    "@google/adk-devtools": "^1.3.0",
    "zod": "^4.4.3"
  }
}
